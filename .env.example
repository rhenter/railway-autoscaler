# Read by load_policy(); the package does not automatically load this file.
RAILWAY_AUTOSCALER_MIN_REPLICAS=1
RAILWAY_AUTOSCALER_MAX_REPLICAS=1

# The planned controller reuses the host Django database for state/history.
# No separate Redis state-store setting is required.

# Celery broker configuration belongs to the host application's Celery setup.
# Django uses CELERY_BROKER_URL when configured with namespace="CELERY".
# The broker may be Redis or RabbitMQ; it is separate from the Django state models.
